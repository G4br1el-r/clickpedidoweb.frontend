{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "vcs": { "enabled": false },
  "files": {
    "includes": [
      "**",
      "!.next",
      "!node_modules",
      "!public",
      "!components/ui",
      "!pnpm-lock.yaml",
      "!next-env.d.ts",
      "!coverage",
      "!test-results",
      "!playwright-report",
      "!.impeccable",
      "!DESIGN.md",
      "!.superpowers"
    ]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "javascript": { "formatter": { "semicolons": "asNeeded", "quoteStyle": "double" } },
  "css": { "parser": { "tailwindDirectives": true } },
  "linter": {
    "enabled": true,
    "rules": { "preset": "recommended" }
  },
  "assist": { "enabled": true }
}
